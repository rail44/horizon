#!/bin/sh
# Local quality gate — same checks AGENTS.md requires before finishing work.
set -e

echo "pre-commit: cargo fmt --check"
cargo fmt --all -- --check

# Discard this workspace's own build artifacts before the gate builds
# anything (backlog 43). The tracked `.cargo/config.toml` shares one
# `build.build-dir` across every worktree, which is a large win for
# dependencies but does NOT key this workspace's crates per worktree:
# two checkouts produce the same artifact filename for every test/bin
# unit, so whichever built last owns the file and every other worktree
# silently runs it — a sibling's code, or a deleted worktree's baked-in
# CARGO_MANIFEST_DIR. Rebuilding our own crates makes the gate measure
# this checkout. Dependencies stay cached, so this costs ~nothing.
# Touching the sources rather than `cargo clean -p`: both force the
# rebuild, but clean also deletes this worktree's finished binaries from
# `target/`, which breaks `cargo run` and leaves Horizon with no
# `horizon-sessiond` to respawn.
echo "pre-commit: touch workspace sources (force rebuild from this checkout)"
git ls-files -z '*.rs' | while IFS= read -r -d '' f; do
  # A tracked file deleted in the working tree (mid-refactor, before the
  # deletion is staged) must not be resurrected as an empty file — that
  # produced E0761 (module found at both session.rs and session/mod.rs)
  # during the session-module split.
  if [ -e "$f" ]; then
    touch "$f"
  fi
done

echo "pre-commit: cargo clippy --workspace --all-targets --locked -- -D warnings"
cargo clippy --workspace --all-targets --locked -- -D warnings

echo "pre-commit: cargo nextest run --workspace --locked"
cargo nextest run --workspace --locked

echo "pre-commit: scripts/check-wire-schema.sh"
./scripts/check-wire-schema.sh
