#!/usr/bin/env bash
# Local quality gate — same checks AGENTS.md requires before finishing work.
set -e

echo "pre-commit: cargo fmt --check"
cargo fmt --all -- --check

# The touch-all-sources defense that used to live here (backlog 43) is
# gone: `.cargo/config.toml`'s `rustc-workspace-wrapper` now keys every
# workspace member's artifacts per worktree, so a sibling checkout can no
# longer overwrite this one's build/test artifacts inside the shared
# build-dir. Dependencies stay shared; nothing needs discarding.

# `cargo clippy` overrides the workspace wrapper via env
# (RUSTC_WORKSPACE_WRAPPER=clippy-driver, the same sysroot path in every
# worktree), which would collapse the per-worktree isolation for the lint
# step and let a sibling's clean check artifacts satisfy this checkout's
# lint — measured 2026-07-30: a real -D warnings violation passed green.
# The --config flag gives the lint step its own per-worktree build-dir
# instead ({workspace-path-hash} resolves per checkout). Costs one cold
# dependency check per worktree the first time; correctness over warmth.
echo "pre-commit: cargo clippy --workspace --all-targets --locked -- -D warnings"
cargo clippy --config 'build.build-dir="{cargo-cache-home}/horizon-clippy-bd/{workspace-path-hash}"' \
  --workspace --all-targets --locked -- -D warnings

# Inside a Horizon sandboxed agent session the default nextest profile
# cannot pass (AGENTS.md): tests that probe the host boundary are skipped
# only by the `sandboxed` profile. The sandbox redirects TMPDIR to a
# worktree-internal `.horizon-sandbox-tmp` directory
# (`crates/horizon-sandbox/src/tmpdir.rs`), so that path suffix is the
# reliable marker that this commit is running contained.
if case "$TMPDIR" in *.horizon-sandbox-tmp) true;; *) false;; esac; then
  echo "pre-commit: cargo nextest run --profile sandboxed --workspace --locked"
  cargo nextest run --profile sandboxed --workspace --locked
else
  echo "pre-commit: cargo nextest run --workspace --locked"
  cargo nextest run --workspace --locked
fi

echo "pre-commit: scripts/check-wire-schema.sh"
./scripts/check-wire-schema.sh
