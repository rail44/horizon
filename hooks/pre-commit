#!/usr/bin/env bash
# Local quality gate — same checks AGENTS.md requires before finishing work.
set -e

# No gate step reads the instruction and documentation files below, so a
# commit that stages nothing else gives the gate nothing to check. The list
# is an allowlist on purpose: Markdown elsewhere can be compiled in (the
# agent's built-in skills are `include_str!`ed) and `config.example.toml` is
# read by tests. `--no-renames` lists both sides of a rename, so moving a
# source file under `docs/` still runs the gate.
staged_any=false
gate_reads_staged=false
while IFS= read -r -d '' path; do
  staged_any=true
  case "$path" in
    AGENTS.md | CLAUDE.md | README.md | docs/*) ;;
    *)
      gate_reads_staged=true
      break
      ;;
  esac
done < <(git diff --cached --name-only --no-renames -z)
if $staged_any && ! $gate_reads_staged; then
  echo "pre-commit: only instruction and documentation files staged; skipping the gate"
  exit 0
fi

echo "pre-commit: cargo fmt --check"
cargo fmt --all -- --check

# Every worktree owns its whole `target/` (sharing happens at the
# compiler level through sccache — see `.cargo/config.toml`), so there is
# no cross-worktree artifact state for this gate to defend against: the
# touch-all-sources loop, the wrapper keying, and the clippy-only
# build-dir side-channel that earlier revisions of this hook carried are
# all gone with the shared build-dir that made them necessary.
echo "pre-commit: cargo clippy --workspace --all-targets --locked -- -D warnings"
cargo clippy --workspace --all-targets --locked -- -D warnings

# Inside a Horizon sandboxed agent session the default nextest profile
# cannot pass (AGENTS.md): tests that probe the host boundary are skipped
# only by the `sandboxed` profile. The sandbox redirects TMPDIR to a
# worktree-internal `.horizon-sandbox-tmp` directory
# (`crates/horizon-sandbox/src/tmpdir.rs`), so that path suffix is the
# reliable marker that this commit is running contained.
if case "$TMPDIR" in *.horizon-sandbox-tmp) true;; *) false;; esac; then
  echo "pre-commit: cargo nextest run --profile sandboxed --workspace --locked"
  cargo nextest run --profile sandboxed --workspace --locked
else
  echo "pre-commit: cargo nextest run --workspace --locked"
  cargo nextest run --workspace --locked
fi

echo "pre-commit: scripts/check-wire-schema.sh"
./scripts/check-wire-schema.sh

echo "pre-commit: scripts/check-preview-wasm.sh"
./scripts/check-preview-wasm.sh
