    },
    "FilesystemGrant": {
      "description": "A canonical, enforceable filesystem grant for a fresh sandbox.\n\n`excluded_subpaths` names relative subpaths within a `DirectoryTree`\ngrant that remain read-only even though the parent tree is writable. The\nseccomp supervisor (Linux) denies writes to these subpaths before checking\ncapability sufficiency, so a ReadWrite grant on `.git/` can exclude\n`.git/hooks/` and `.git/config/` — the host-escalation vectors a deceived\njudge could otherwise enable. On macOS (no seccomp supervisor) the field\nis advisory. Board #38; see\n`docs/agent-approval-design.md`.",
      "properties": {
        "access": {
          "$ref": "#/$defs/FilesystemGrantAccess"
        },
        "excluded_subpaths": {
          "default": [],
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "path": {
          "type": "string"
        },
        "scope": {
          "$ref": "#/$defs/FilesystemGrantScope"
        }
      },
      "required": [
        "path",
        "access",
        "scope"
      ],
      "type": "object"
    },
    "FilesystemGrantAccess": {
      "description": "Access added by an approved, session-scoped containment grant.",
      "enum": [
        "Read",
        "ReadWrite"
      ],
      "type": "string"
    },
    "FilesystemGrantScope": {
      "description": "The actual enforcement scope shown to the approver.",
      "enum": [
        "File",
        "DirectoryTree"
      ],
      "type": "string"
    },
