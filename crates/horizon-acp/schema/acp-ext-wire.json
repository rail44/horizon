{
  "$comment": "Generated from the live horizon-acp extension types (the _horizon/* methods and the _meta.horizon payloads). Regenerate with `HORIZON_BLESS_WIRE_SCHEMA=1 cargo nextest run -p horizon-acp wire_schema`; additive-vs-reshape classification of changes is scripts/check-wire-schema.sh.",
  "$defs": {
    "ApprovalKind": {
      "description": "Mirrors `contract::ApprovalKind` (crates/horizon-agent/src/contract.rs).",
      "oneOf": [
        {
          "properties": {
            "type": {
              "const": "standard",
              "type": "string"
            }
          },
          "required": [
            "type"
          ],
          "type": "object"
        },
        {
          "properties": {
            "domains": {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            "type": {
              "const": "domain_grant",
              "type": "string"
            }
          },
          "required": [
            "type",
            "domains"
          ],
          "type": "object"
        }
      ]
    },
    "ApprovalMeta": {
      "description": "Mirrors `contract::ApprovalRequest` minus `reason`, keyed by its\n`ToolCallIdentity` (crates/horizon-agent/src/contract.rs).",
      "properties": {
        "call_id": {
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/ApprovalKind"
        },
        "occurrence_id": {
          "type": "string"
        },
        "task_session_id": {
          "description": "The `task` child this approval is for, when it is not the session's\nown: shown through the session, answered to the child\n(`docs/agent-subagent-design.md` decision 4).",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "call_id",
        "occurrence_id",
        "kind"
      ],
      "type": "object"
    },
    "AttachmentEnd": {
      "description": "Mirrors `hosting::AttachmentEnd` (crates/horizon-agent/src/hosting.rs).",
      "enum": [
        "replaced",
        "lagged",
        "detached",
        "session_ended"
      ],
      "type": "string"
    },
    "EnsureBoardOrganizerRequest": {
      "description": "Starts, or finds, a workspace's board organizer session.",
      "properties": {
        "workspace_root": {
          "type": "string"
        }
      },
      "required": [
        "workspace_root"
      ],
      "type": "object"
    },
    "EnsureBoardOrganizerResponse": {
      "properties": {
        "session_id": {
          "$ref": "#/$defs/SessionId"
        }
      },
      "required": [
        "session_id"
      ],
      "type": "object"
    },
    "InitializeMeta": {
      "description": "`initialize` request and response, both directions.",
      "properties": {
        "binary_id": {
          "type": "string"
        },
        "ext_version": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "ext_version",
        "binary_id"
      ],
      "type": "object"
    },
    "ListProviderModelsRequest": {
      "description": "Lists a provider's own model ids (its `GET /models`).",
      "properties": {
        "provider": {
          "type": "string"
        }
      },
      "required": [
        "provider"
      ],
      "type": "object"
    },
    "ListProviderModelsResponse": {
      "properties": {
        "models": {
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "required": [
        "models"
      ],
      "type": "object"
    },
    "ListProvidersRequest": {
      "description": "Lists the configured providers.",
      "type": "object"
    },
    "ListProvidersResponse": {
      "properties": {
        "providers": {
          "items": {
            "$ref": "#/$defs/ProviderSummary"
          },
          "type": "array"
        }
      },
      "required": [
        "providers"
      ],
      "type": "object"
    },
    "MessageMeta": {
      "description": "Mirrors the non-human `contract::MessageRole` variants (crates/horizon-agent/src/contract.rs).",
      "properties": {
        "role": {
          "$ref": "#/$defs/MessageRole"
        }
      },
      "required": [
        "role"
      ],
      "type": "object"
    },
    "MessageRole": {
      "enum": [
        "task_notification",
        "auto_continue"
      ],
      "type": "string"
    },
    "ModelOptionMeta": {
      "description": "Carried under `_meta.horizon` on each `model` config option entry.",
      "properties": {
        "model": {
          "type": "string"
        },
        "provider": {
          "type": "string"
        }
      },
      "required": [
        "provider",
        "model"
      ],
      "type": "object"
    },
    "ProviderSummary": {
      "description": "Mirrors `hosting::ProviderSummary` (crates/horizon-agent/src/hosting.rs).",
      "properties": {
        "api_key_env": {
          "description": "The environment variable name the entry's API key is read from.",
          "type": "string"
        },
        "available": {
          "type": "boolean"
        },
        "base_url": {
          "type": [
            "string",
            "null"
          ]
        },
        "default": {
          "type": "boolean"
        },
        "default_model": {
          "type": [
            "string",
            "null"
          ]
        },
        "name": {
          "type": "string"
        }
      },
      "required": [
        "name",
        "api_key_env",
        "available",
        "default"
      ],
      "type": "object"
    },
    "SessionEventNotification": {
      "description": "Mirrors `contract::Event::{SessionResumed, ProviderRateLimited,\nHistoryCleared, Error, Exited}` (crates/horizon-agent/src/contract.rs),\n`hosting::AgentWireEvent::AttachmentClosed`\n(crates/horizon-agent/src/hosting.rs) and the daemon's startup\nevent-log skipped-lines diagnostic.",
      "oneOf": [
        {
          "properties": {
            "session_id": {
              "$ref": "#/$defs/SessionId"
            },
            "type": {
              "const": "session_resumed",
              "type": "string"
            }
          },
          "required": [
            "type",
            "session_id"
          ],
          "type": "object"
        },
        {
          "properties": {
            "attempt": {
              "format": "uint32",
              "minimum": 0,
              "type": "integer"
            },
            "backoff_ms": {
              "format": "uint64",
              "minimum": 0,
              "type": "integer"
            },
            "session_id": {
              "$ref": "#/$defs/SessionId"
            },
            "status": {
              "format": "uint16",
              "maximum": 65535,
              "minimum": 0,
              "type": [
                "integer",
                "null"
              ]
            },
            "type": {
              "const": "provider_rate_limited",
              "type": "string"
            }
          },
          "required": [
            "type",
            "session_id",
            "attempt",
            "backoff_ms"
          ],
          "type": "object"
        },
        {
          "properties": {
            "cleared_occurrence_ids": {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            "recovered_chars": {
              "format": "uint64",
              "minimum": 0,
              "type": "integer"
            },
            "session_id": {
              "$ref": "#/$defs/SessionId"
            },
            "type": {
              "const": "history_cleared",
              "type": "string"
            }
          },
          "required": [
            "type",
            "session_id",
            "cleared_occurrence_ids",
            "recovered_chars"
          ],
          "type": "object"
        },
        {
          "properties": {
            "reason": {
              "$ref": "#/$defs/AttachmentEnd"
            },
            "session_id": {
              "$ref": "#/$defs/SessionId"
            },
            "type": {
              "const": "attachment_closed",
              "type": "string"
            }
          },
          "required": [
            "type",
            "session_id",
            "reason"
          ],
          "type": "object"
        },
        {
          "description": "A mid-session failure the daemon reports outside any request.",
          "properties": {
            "message": {
              "type": "string"
            },
            "session_id": {
              "$ref": "#/$defs/SessionId"
            },
            "type": {
              "const": "error",
              "type": "string"
            }
          },
          "required": [
            "type",
            "session_id",
            "message"
          ],
          "type": "object"
        },
        {
          "description": "The session's process-level exit.",
          "properties": {
            "reason": {
              "type": "string"
            },
            "session_id": {
              "$ref": "#/$defs/SessionId"
            },
            "type": {
              "const": "exited",
              "type": "string"
            }
          },
          "required": [
            "type",
            "session_id",
            "reason"
          ],
          "type": "object"
        },
        {
          "description": "The daemon's startup event-log corruption summary; not per-session.",
          "properties": {
            "summary": {
              "type": "string"
            },
            "type": {
              "const": "skipped_lines",
              "type": "string"
            }
          },
          "required": [
            "type",
            "summary"
          ],
          "type": "object"
        }
      ]
    },
    "SessionId": {
      "description": "This crate's own session identifier: a UUID newtype that serializes as a\nbare UUID string (serde's transparent treatment of one-field tuple\nstructs) — the shape a future wire/IPC boundary will use (see\n`docs/agent-runtime-split-design.md`). Horizon has its own shared\n`session::SessionId` (used across terminal and agent sessions alike) —\nthis crate cannot depend on it (that's the whole point of the split), so\nthe two are distinct types connected by `From` impls at the seam in\nHorizon's `agent` module.",
      "format": "uuid",
      "type": "string"
    },
    "SessionInfoMeta": {
      "description": "Mirrors `hosting::SessionSummary` minus `session_id` (crates/horizon-agent/src/hosting.rs).",
      "properties": {
        "parent_session_id": {
          "anyOf": [
            {
              "$ref": "#/$defs/SessionId"
            },
            {
              "type": "null"
            }
          ]
        },
        "provider_id": {
          "type": "string"
        },
        "role_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "workspace_root": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "provider_id"
      ],
      "type": "object"
    },
    "SessionNewMeta": {
      "description": "Mirrors `hosting::SessionNew` minus `workspace_root` (crates/horizon-agent/src/hosting.rs).",
      "properties": {
        "provider_id": {
          "type": "string"
        },
        "role_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "session_id": {
          "$ref": "#/$defs/SessionId"
        },
        "spawn_source_session_id": {
          "anyOf": [
            {
              "$ref": "#/$defs/SessionId"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "session_id",
        "provider_id"
      ],
      "type": "object"
    },
    "ToolCallMeta": {
      "description": "`tool_call_update`, whose `toolCallId` is the occurrence id. Mirrors\n`contract::ToolCallRequest`/`ToolCallResult` (crates/horizon-agent/src/contract.rs)\nand the result evidence fields (crates/horizon-agent/src/tools/output/evidence.rs).",
      "properties": {
        "auto_approved": {
          "default": null,
          "type": [
            "boolean",
            "null"
          ]
        },
        "call_id": {
          "type": "string"
        },
        "outcome": {
          "anyOf": [
            {
              "$ref": "#/$defs/ToolOutcome"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Present once the call has a result."
        },
        "policy_tier": {
          "default": null,
          "type": [
            "string",
            "null"
          ]
        },
        "tool_id": {
          "type": "string"
        }
      },
      "required": [
        "call_id",
        "tool_id"
      ],
      "type": "object"
    },
    "ToolOutcome": {
      "description": "Mirrors `contract::ToolOutcome` (crates/horizon-agent/src/contract/tool_result.rs).",
      "oneOf": [
        {
          "properties": {
            "type": {
              "const": "succeeded",
              "type": "string"
            }
          },
          "required": [
            "type"
          ],
          "type": "object"
        },
        {
          "properties": {
            "type": {
              "const": "failed",
              "type": "string"
            }
          },
          "required": [
            "type"
          ],
          "type": "object"
        },
        {
          "properties": {
            "type": {
              "const": "denied",
              "type": "string"
            }
          },
          "required": [
            "type"
          ],
          "type": "object"
        },
        {
          "properties": {
            "type": {
              "const": "cancelled",
              "type": "string"
            }
          },
          "required": [
            "type"
          ],
          "type": "object"
        },
        {
          "properties": {
            "retry_occurrence_id": {
              "type": "string"
            },
            "type": {
              "const": "superseded",
              "type": "string"
            }
          },
          "required": [
            "type",
            "retry_occurrence_id"
          ],
          "type": "object"
        }
      ]
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "client_to_agent": {
    "_horizon/ensure_board_organizer": {
      "reply": {
        "$ref": "#/$defs/EnsureBoardOrganizerResponse"
      },
      "request": {
        "$ref": "#/$defs/EnsureBoardOrganizerRequest"
      }
    },
    "_horizon/list_provider_models": {
      "reply": {
        "$ref": "#/$defs/ListProviderModelsResponse"
      },
      "request": {
        "$ref": "#/$defs/ListProviderModelsRequest"
      }
    },
    "_horizon/list_providers": {
      "reply": {
        "$ref": "#/$defs/ListProvidersResponse"
      },
      "request": {
        "$ref": "#/$defs/ListProvidersRequest"
      }
    }
  },
  "meta": {
    "config_option": {
      "$ref": "#/$defs/ModelOptionMeta"
    },
    "initialize": {
      "$ref": "#/$defs/InitializeMeta"
    },
    "message": {
      "$ref": "#/$defs/MessageMeta"
    },
    "request_permission": {
      "$ref": "#/$defs/ApprovalMeta"
    },
    "session_info": {
      "$ref": "#/$defs/SessionInfoMeta"
    },
    "session_new": {
      "$ref": "#/$defs/SessionNewMeta"
    },
    "tool_call": {
      "$ref": "#/$defs/ToolCallMeta"
    }
  },
  "notifications": {
    "_horizon/session_event": {
      "$ref": "#/$defs/SessionEventNotification"
    }
  },
  "stop_reasons": [
    "_horizon/failed"
  ],
  "title": "horizon-acp-ext-wire",
  "x-session-protocol-version": 18
}
