package horizon-ext:markdown@0.1.0;

world markdown {
    include horizon:ui/imports;

    use horizon:ui/files.{file};

    record state {
        path: option<string>,
    }

    export mount: func(state: option<state>) -> u64;
    export state: func() -> state;
    export create: func(file: file) -> state;

    export commands: interface {
        back: func();
    }
}
